# Application
PORT=3000

# PostgreSQL (TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_auth

# JWT — module default + dual-token secrets
JWT_SECRET=change-me-jwt-module-secret
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# TTL in seconds (used for both access and refresh token signing)
JWT_ACCESS_TOKEN_TTL=3600

# Redis (ioredis — port is 6379 in RedisService)
REDIS_HOST=localhost
REDIS_PASSWORD=change-me-redis-password
